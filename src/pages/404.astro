---
// Página 404 bilingüe (Netlify la sirve para cualquier ruta inexistente). No se indexa.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon';
---
<Base lang="es" title="Página no encontrada · Page not found | Vanguard Aero Services" description="La página que busca no existe. The page you are looking for does not exist." noindex>
  <Header lang="es" solid />
  <main id="main" class="bg-paper pt-40 pb-28 lg:pt-48 lg:pb-36">
    <div class="wrap grid gap-14 md:grid-cols-2 md:gap-10">
      <div>
        <p class="kicker">Error 404</p>
        <h1 class="h-section mt-4">Esta página no existe</h1>
        <p class="lede mt-6">Es posible que el enlace esté desactualizado. Vuelva al inicio o contacte a nuestro centro de operaciones 24/7.</p>
        <a href="/" class="btn btn-dark mt-8">Ir al inicio<Icon name="arrow" className="arr" /></a>
      </div>
      <div lang="en" class="border-t border-stone pt-10 md:border-t-0 md:border-l md:pt-0 md:pl-10">
        <p class="kicker">Error 404</p>
        <p class="h-section mt-4">This page doesn’t exist</p>
        <p class="lede mt-6">The link may be outdated. Go back to the homepage or contact our 24/7 operations center.</p>
        <a href="/en/" class="btn btn-line-dark mt-8">Go to homepage<Icon name="arrow" className="arr" /></a>
      </div>
    </div>
  </main>
  <Footer lang="es" />
</Base>
