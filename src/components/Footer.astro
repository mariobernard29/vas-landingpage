---
import Icon from './Icon';
import { t, homePath, otherLang, type Lang } from '../i18n';
import { legalSlugs, legalLabels } from '../i18n/legal';
import { SITE } from '../config';

const { lang, otherPath } = Astro.props as { lang: Lang; otherPath?: string };
const d = t(lang);
const h = homePath(lang);
const other = otherLang(lang);
const f = d.footer;
const cols = [
  [f.cols.services, [[h + '#management', f.services[0]], [h + '#fbo', f.services[1]], [h + '#aog', f.services[2]], [h + '#permits', f.services[3]]]],
  [f.cols.operations, [[h + '#destinations', f.operations[0]], [h + '#destinations', f.operations[1]], [h + '#contact', f.operations[2]]]],
  [f.cols.company, [
    [h + '#about', d.nav.about], [h + '#contact', d.nav.contact],
    [legalSlugs[lang].privacy, legalLabels[lang].privacy], [legalSlugs[lang].terms, legalLabels[lang].terms], [legalSlugs[lang].cookies, legalLabels[lang].cookies],
  ]],
] as const;
---
<footer class="on-dark bg-[#0c0e11] text-white">
  <div class="wrap pt-16 pb-10 md:pt-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href={h} aria-label="Vanguard Aero Services" class="inline-block">
          <img src="/brand/logo-horizontal-white.png" alt="Vanguard Aero Services" width="549" height="120" class="h-9 w-auto" loading="lazy" />
        </a>
        <p class="mt-6 max-w-xs text-[14px] leading-[1.6] text-mist">{f.tagline}</p>
        <dl class="mt-8 space-y-4 text-[14px]">
          <div>
            <dt class="kicker">{d.nav.menuContact}</dt>
            <dd class="mt-1"><a href={SITE.phoneHref} class="ulink">{SITE.phone}</a></dd>
          </div>
          <div>
            <dt class="kicker">Email</dt>
            <dd class="mt-1"><a href={`mailto:${SITE.email}`} class="ulink">{SITE.email}</a></dd>
          </div>
        </dl>
      </div>

      <nav class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:col-span-7 lg:col-start-6" aria-label="Footer">
        {cols.map(([title, items]) => (
          <div>
            <p class="kicker mb-5">{title}</p>
            <ul class="space-y-3 text-[14px]">
              {items.map(([href, label]) => <li><a href={href} class="ulink text-white/85 hover:text-white">{label}</a></li>)}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="mt-16 flex flex-col gap-6 border-t border-white/12 pt-8 text-[13px] text-mist md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} Vanguard Aero Services. {f.rights}</p>
      <div class="flex items-center gap-8">
        <p class="tracking-[0.04em]">
          <span class="font-semibold text-white">{lang.toUpperCase()}</span><span class="mx-1">/</span><a href={otherPath ?? homePath(other)} hreflang={other} class="ulink" aria-label={d.nav.langLabel}>{other.toUpperCase()}</a>
        </p>
        <a href="#top" class="inline-flex items-center gap-2 ulink">{f.top}<Icon name="up" size={14} /></a>
      </div>
    </div>
  </div>
</footer>
