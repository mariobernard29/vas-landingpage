---
// Foto de /public/images en tres tamaños (-sm 960 px, -md 1600 px y original).
// Las dimensiones (src/photos.json, generado por scripts/fetch-photos.mjs) evitan saltos de maquetación.
// En contenedores recortados con object-cover, `sizes` debe indicar el ancho que ocupa la foto completa, no el contenedor.
import dims from '../photos.json';

interface Props {
  name: string;
  alt: string;
  sizes?: string;
  class?: string;
  priority?: boolean;
  [attr: string]: unknown;
}
const { name, alt, sizes = '100vw', class: cls, priority = false, ...rest } = Astro.props;
const [w, h] = (dims as Record<string, [number, number]>)[name] ?? [1600, 1000];
const set = [`/images/${name}-sm.jpg 960w`];
if (w > 1800 && name !== 'management') set.push(`/images/${name}-md.jpg 1600w`);
set.push(`/images/${name}.jpg ${w}w`);
---
<img
  src={`/images/${name}.jpg`}
  srcset={set.join(', ')}
  sizes={sizes}
  width={w}
  height={h}
  alt={alt}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : undefined}
  class={cls}
  {...rest}
/>
