---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { homePath, otherLang, type Lang } from '../i18n';
import { legal, legalSlugs, legalLabels, legalMeta, type LegalKey } from '../i18n/legal';
import { SITE } from '../config';

const { lang, k } = Astro.props as { lang: Lang; k: LegalKey };
const page = legal[lang][k];
const meta = legalMeta[lang];
const other = otherLang(lang);
const keys: LegalKey[] = ['privacy', 'terms', 'cookies'];
// **negrita** simple
const fmt = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-ink">$1</strong>');
---
<Base lang={lang} title={`${page.title} | Vanguard Aero Services`} description={page.lead}
  path={legalSlugs[lang][k]} otherPath={legalSlugs[other][k]}>
  <Header lang={lang} otherPath={legalSlugs[other][k]} solid />
  <main id="main" class="bg-paper pt-32 pb-24 lg:pt-40 lg:pb-32">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
      <aside class="lg:col-span-3">
        <a href={homePath(lang)} class="ulink text-[13px] text-steel hover:text-ink">← {meta.back}</a>
        <nav class="mt-10 hidden flex-col border-t border-stone lg:flex" aria-label="Legal">
          {keys.map((key) => (
            <a href={legalSlugs[lang][key]} aria-current={key === k ? 'page' : undefined}
              class:list={['border-b border-stone py-3 text-[14px] transition-colors', key === k ? 'font-medium text-ink' : 'text-steel hover:text-ink']}>{legalLabels[lang][key]}</a>
          ))}
        </nav>
      </aside>

      <article class="max-w-[720px] lg:col-span-8 lg:col-start-5">
        <p class="kicker">{meta.updated}: {meta.date}</p>
        <h1 class="h-section mt-4">{page.title}</h1>
        <p class="lede mt-6">{page.lead}</p>

        <div class="mt-14 space-y-12">
          {page.sections.map((s) => (
            <section>
              <h2 class="border-b border-stone pb-4 text-[18px] font-medium">{s.h}</h2>
              <div class="mt-5 space-y-4 text-[16px] leading-[1.7] text-steel">
                {s.p.map((p) => <p set:html={fmt(p)} />)}
              </div>
            </section>
          ))}
        </div>

        <div class="mt-16 border-t border-ink/80 pt-6 text-[14px] text-steel">
          <p>{meta.draftNote}</p>
          <p class="mt-2">{lang === 'es' ? 'Contacto' : 'Contact'}: <a class="ulink text-ink" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </div>
      </article>
    </div>
  </main>
  <Footer lang={lang} otherPath={legalSlugs[other][k]} />
</Base>
