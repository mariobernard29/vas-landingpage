---
// Selector de idioma con banderas (SVG en línea: los emojis de bandera no se ven en Windows).
import { t, homePath, otherLang, type Lang } from '../i18n';
const { lang, otherPath, class: cls } = Astro.props as { lang: Lang; otherPath?: string; class?: string };
const other = otherLang(lang);
const href = otherPath ?? homePath(other);
const names = { es: 'Español', en: 'English' } as const;
const order: Lang[] = ['es', 'en'];
---
<div class:list={['lang-switch flex items-center gap-2', cls]} role="group" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
  {order.map((l) => {
    const flag = l === 'es' ? (
      <svg viewBox="0 0 30 20" aria-hidden="true">
        <rect width="30" height="20" fill="#AA151B" />
        <rect y="5" width="30" height="10" fill="#F1BF00" />
      </svg>
    ) : (
      <svg viewBox="0 0 30 20" aria-hidden="true">
        <rect width="30" height="20" fill="#B22234" />
        <path d="M0 2.31h30M0 5.38h30M0 8.46h30M0 11.54h30M0 14.62h30M0 17.69h30" stroke="#fff" stroke-width="1.54" />
        <rect width="12" height="10.77" fill="#3C3B6E" />
        <g fill="#fff">
          {[1.5, 4.5, 7.5, 10.5].flatMap((x) => [1.6, 4.1, 6.6, 9.1].map((y) => <circle cx={x} cy={y} r=".55" />))}
          {[3, 6, 9].flatMap((x) => [2.85, 5.35, 7.85].map((y) => <circle cx={x} cy={y} r=".55" />))}
        </g>
      </svg>
    );
    return l === lang ? (
      <span class="flag is-current" aria-current="true" title={names[l]}>{flag}<span class="sr-only">{names[l]}</span></span>
    ) : (
      <a href={href} hreflang={l} lang={l} class="flag" title={names[l]} aria-label={t(lang).nav.langLabel}>{flag}</a>
    );
  })}
</div>

<style>
  .flag {
    display: inline-flex;
    width: 24px;
    height: 16px;
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgb(127 127 127 / 0.35);
    transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .flag svg { width: 100%; height: 100%; display: block; }
  a.flag { opacity: 0.5; filter: saturate(0.6); }
  a.flag:hover, a.flag:focus-visible { opacity: 1; filter: none; transform: translateY(-1px); }
  .flag.is-current { box-shadow: 0 0 0 1.5px currentColor; }
</style>
